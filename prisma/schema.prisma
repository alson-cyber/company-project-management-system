// Production schema. See docs/ARCHITECTURE-PLAN.md §4 and docs/PRODUCT-RULES.md.
// Authentication tables (User, Session, Account, Verification) follow the Better Auth core schema.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

/// Workspace-wide grants. Plain workspace membership is the MEMBER baseline.
enum WorkspaceRole {
  ADMIN
  EXECUTIVE
}

/// LEAD is the PROJECT_LEAD concept. At most one LEAD per project (partial unique index).
enum ProjectRole {
  LEAD
  MEMBER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum ProjectHealth {
  HEALTHY
  ATTENTION
  AT_RISK
  BLOCKED
}

enum ActorType {
  USER
  SYSTEM
}

/// Personal attention. This is not activity: read state lives here and never rewrites the audit log.
enum NotificationType {
  ISSUE_ASSIGNED
  ISSUE_COMMENTED
  ISSUE_NOTE_ADDED
  ISSUE_STATUS_CHANGED
  ISSUE_DUE_SOON
  ISSUE_OVERDUE
  PROJECT_MEMBERSHIP
}

enum IssueType {
  EPIC
  USER_STORY
  TASK
  SUB_TASK
}

enum IssueStatus {
  TO_DO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum IssuePriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

// ---------------------------------------------------------------------------
// Identity (Better Auth core models + profile fields)
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?
  jobTitle      String?    @map("job_title")
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  sessions             Session[]
  accounts             Account[]
  workspaceMemberships WorkspaceMember[]
  roleGrants           WorkspaceRoleGrant[] @relation("RoleGrantee")
  roleGrantsGiven      WorkspaceRoleGrant[] @relation("RoleGrantor")
  projectMemberships   ProjectMember[]      @relation("ProjectMemberUser")
  membershipsAdded     ProjectMember[]      @relation("ProjectMemberAddedBy")
  projectsCreated      Project[]            @relation("ProjectCreatedBy")
  healthUpdates        Project[]            @relation("ProjectHealthUpdatedBy")
  activityEvents       ActivityEvent[]
  issuesCreated        Issue[]              @relation("IssueCreatedBy")
  issuesReported       Issue[]              @relation("IssueReporter")
  issuesAssigned       Issue[]              @relation("IssueAssignee")
  issuesCompleted      Issue[]              @relation("IssueCompletedBy")
  issuesArchived       Issue[]              @relation("IssueArchivedBy")
  criteriaMarkedMet    AcceptanceCriterion[] @relation("CriterionMetBy")
  notesAuthored        IssueNote[]           @relation("IssueNoteAuthor")
  commentsAuthored     IssueComment[]        @relation("IssueCommentAuthor")
  attachmentsUploaded  IssueAttachment[]     @relation("IssueAttachmentUploader")
  notificationsReceived Notification[]       @relation("NotificationRecipient")
  notificationsActed    Notification[]       @relation("NotificationActor")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Workspace boundary
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members        WorkspaceMember[]
  roleGrants     WorkspaceRoleGrant[]
  projects       Project[]
  activityEvents ActivityEvent[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  joinedAt    DateTime @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceRoleGrant {
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  grantedById String?       @map("granted_by_id")
  grantedAt   DateTime      @default(now()) @map("granted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation("RoleGrantee", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User?     @relation("RoleGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([workspaceId, userId, role])
  @@index([userId])
  @@map("workspace_role_grants")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id                String         @id @default(uuid())
  workspaceId       String         @map("workspace_id")
  key               String
  name              String
  description       String?
  color             String         @default("#4f6cf7")
  status            ProjectStatus  @default(PLANNING)
  health            ProjectHealth?
  healthNote        String?        @map("health_note")
  healthUpdatedAt   DateTime?      @map("health_updated_at")
  healthUpdatedById String?        @map("health_updated_by_id")
  targetDate        DateTime?      @map("target_date") @db.Date
  createdById       String         @map("created_by_id")
  nextIssueNumber   Int            @default(1) @map("next_issue_number")
  archivedAt        DateTime?      @map("archived_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy       User            @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  healthUpdatedBy User?           @relation("ProjectHealthUpdatedBy", fields: [healthUpdatedById], references: [id], onDelete: Restrict)
  members         ProjectMember[]
  activityEvents  ActivityEvent[]
  issues          Issue[]
  labels          Label[]
  notifications   Notification[]

  @@unique([workspaceId, key])
  @@index([workspaceId, archivedAt])
  @@map("projects")
}

model ProjectMember {
  projectId String      @map("project_id")
  userId    String      @map("user_id")
  role      ProjectRole @default(MEMBER)
  addedById String?     @map("added_by_id")
  joinedAt  DateTime    @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user    User    @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  addedBy User?   @relation("ProjectMemberAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@unique([projectId], map: "project_members_one_lead_per_project", where: raw("role = 'LEAD'"))
  @@index([userId])
  @@map("project_members")
}

// ---------------------------------------------------------------------------
// Activity / audit (append-only; see migration trigger and docs/ARCHITECTURE-PLAN.md §7)
// ---------------------------------------------------------------------------

model ActivityEvent {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  occurredAt  DateTime  @default(now()) @map("occurred_at")
  actorType   ActorType @map("actor_type")
  actorUserId String?   @map("actor_user_id")
  projectId   String?   @map("project_id")
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  issueId     String?   @map("issue_id")
  action      String
  before      Json?
  after       Json?
  metadata    Json?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  issue     Issue?    @relation(fields: [issueId], references: [id], onDelete: Restrict)

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([projectId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([issueId, occurredAt(sort: Desc)])
  @@map("activity_events")
}

// ---------------------------------------------------------------------------
// Issues (Project → Epic → User Story → Task → Sub-task)
// ---------------------------------------------------------------------------

model Issue {
  id            String        @id @default(uuid())
  projectId     String        @map("project_id")
  number        Int
  type          IssueType
  parentId      String?       @map("parent_id")
  title         String
  description   String?
  status        IssueStatus   @default(TO_DO)
  priority      IssuePriority @default(MEDIUM)
  assigneeId    String?       @map("assignee_id")
  reporterId    String        @map("reporter_id")
  createdById   String        @map("created_by_id")
  dueDate          DateTime?     @map("due_date") @db.Date
  /// Planning start. Never derived from createdAt. Null means unscheduled.
  plannedStartDate DateTime?     @map("planned_start_date") @db.Date
  rank             String        @default("a0")
  completedAt      DateTime?     @map("completed_at")
  completedById String?       @map("completed_by_id")
  archivedAt    DateTime?     @map("archived_at")
  archivedById  String?       @map("archived_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  parent      Issue?                @relation("IssueHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Issue[]               @relation("IssueHierarchy")
  assignee    User?                 @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  reporter    User                  @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  createdBy   User                  @relation("IssueCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy User?                 @relation("IssueCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  archivedBy  User?                 @relation("IssueArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  story       UserStoryDetails?
  criteria    AcceptanceCriterion[]
  labels      IssueLabel[]
  activity    ActivityEvent[]
  notes         IssueNote[]
  comments      IssueComment[]
  attachments   IssueAttachment[]
  notifications Notification[]

  @@unique([projectId, number])
  @@index([projectId, parentId])
  @@index([projectId, type])
  @@index([projectId, status])
  @@index([projectId, archivedAt])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("issues")
}

model UserStoryDetails {
  issueId String @id @map("issue_id")
  asA     String @map("as_a")
  iWant   String @map("i_want")
  soThat  String @map("so_that")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Restrict)

  @@map("user_story_details")
}

model AcceptanceCriterion {
  id        String    @id @default(uuid())
  issueId   String    @map("issue_id")
  position  Int
  text      String
  isMet     Boolean   @default(false) @map("is_met")
  metById   String?   @map("met_by_id")
  metAt     DateTime? @map("met_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Restrict)
  metBy User? @relation("CriterionMetBy", fields: [metById], references: [id], onDelete: Restrict)

  @@index([issueId, deletedAt])
  @@map("acceptance_criteria")
}

model Label {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  color     String   @default("#64748b")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  issues  IssueLabel[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("labels")
}

model IssueLabel {
  issueId String @map("issue_id")
  labelId String @map("label_id")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Restrict)
  label Label @relation(fields: [labelId], references: [id], onDelete: Restrict)

  @@id([issueId, labelId])
  @@index([labelId])
  @@map("issue_labels")
}

/// Internal working notes. Distinct from comments and from the issue description.
model IssueNote {
  id        String    @id @default(uuid())
  issueId   String    @map("issue_id")
  authorId  String    @map("author_id")
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Restrict)
  author User  @relation("IssueNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([issueId, deletedAt, createdAt])
  @@map("issue_notes")
}

/// Issue discussion. Intentionally flat: no threads, reactions, or mentions.
model IssueComment {
  id        String    @id @default(uuid())
  issueId   String    @map("issue_id")
  authorId  String    @map("author_id")
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Restrict)
  author User  @relation("IssueCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([issueId, deletedAt, createdAt])
  @@map("issue_comments")
}

/// File metadata. The bytes live in object storage under objectKey, never under the user's filename.
model IssueAttachment {
  id               String    @id @default(uuid())
  issueId          String    @map("issue_id")
  uploadedById     String    @map("uploaded_by_id")
  originalFilename String    @map("original_filename")
  objectKey        String    @unique @map("object_key")
  contentType      String    @map("content_type")
  sizeBytes        Int       @map("size_bytes")
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  issue      Issue @relation(fields: [issueId], references: [id], onDelete: Restrict)
  uploadedBy User  @relation("IssueAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([issueId, deletedAt, createdAt])
  @@map("issue_attachments")
}

/// User-specific attention. Activity remains the system of record for what happened.
model Notification {
  id          String           @id @default(uuid())
  recipientId String           @map("recipient_id")
  actorId     String?          @map("actor_id")
  projectId   String?          @map("project_id")
  issueId     String?          @map("issue_id")
  type        NotificationType
  dedupeKey   String           @map("dedupe_key")
  metadata    Json?
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Restrict)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  issue     Issue?   @relation(fields: [issueId], references: [id], onDelete: Restrict)

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}
