# Copy to `.env` for local development:  cp .env.example .env
# Every variable is validated at startup by src/server/env.ts.

# --- Database -----------------------------------------------------------------
# Matches docker-compose.yml (host port 55432 by default; override with PMS_POSTGRES_PORT).
DATABASE_URL="postgresql://pms:pms_local_dev@localhost:55432/pms_dev"
# Used by `pnpm test:integration` and Playwright. Created automatically by docker/postgres/init.
TEST_DATABASE_URL="postgresql://pms:pms_local_dev@localhost:55432/pms_test"

# --- Authentication -----------------------------------------------------------
# Generate a value with:  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"
# Public origin of the app. Used for cookies, redirects and OAuth callbacks.
BETTER_AUTH_URL="http://localhost:3000"
# Email + password sign-in for pre-provisioned users. Sign-up is always disabled.
AUTH_PASSWORD_LOGIN_ENABLED="true"

# Optional company SSO (any OpenID Connect provider). Leave all blank to disable.
# When set, the login screen shows a "Continue with <display name>" button.
# Only users that already exist in the workspace can sign in through SSO.
AUTH_OIDC_PROVIDER_ID=""
AUTH_OIDC_DISPLAY_NAME=""
AUTH_OIDC_DISCOVERY_URL=""
AUTH_OIDC_CLIENT_ID=""
AUTH_OIDC_CLIENT_SECRET=""

# --- Workspace ----------------------------------------------------------------
# Slug of the workspace this deployment serves (created by the seed in development).
WORKSPACE_SLUG="company"

# --- File storage (attachments are implemented in a later stage) --------------
# "local" (development) or "s3" (any S3-compatible service).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/storage"
# Required only when STORAGE_DRIVER="s3".
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Maximum attachment size in bytes (default 25 MB).
ATTACHMENT_MAX_BYTES="26214400"

# --- Development seed ---------------------------------------------------------
# Password given to every seeded development user. Development/test only.
SEED_DEV_PASSWORD="workhub-dev-only-pass"
